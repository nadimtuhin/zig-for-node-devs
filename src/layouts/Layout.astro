---
import {
  SITE_ORIGIN,
  buildPageSchema,
  serializeJsonLd,
  type ArticleMeta,
  type Breadcrumb,
  type CodeSnippet,
  type FaqEntry
} from '../lib/structuredData';

interface Props {
  title?: string;
  description?: string;
  canonicalPath?: string;
  breadcrumbs?: Breadcrumb[];
  article?: ArticleMeta;
  faq?: FaqEntry[];
  codeSnippet?: CodeSnippet;
  isPart?: string;
  chapterNum?: number;
}

const {
  title = "Zig for Node.js Devs | Interactive GitBook & Live Compiler",
  description = "Learn Zig with live in-browser Zig Compiler Explorer & Playground, progressive lessons, side-by-side Node.js/TypeScript comparisons, and production systems architecture guides.",
  canonicalPath = Astro.url.pathname,
  breadcrumbs = [],
  article,
  faq,
  codeSnippet,
  isPart,
  chapterNum
} = Astro.props;

import '../styles/global.css';

const cleanPath = canonicalPath.replace(/\/+$/, '') || '';
const canonicalUrl = `${SITE_ORIGIN}${cleanPath}`;
const ogImageUrl = `${SITE_ORIGIN}/og-image.png`;
const pageName = title.split('|')[0].trim();

const defaultBreadcrumbs = [
  { name: "Home", item: SITE_ORIGIN },
  ...(cleanPath ? [{ name: pageName, item: canonicalUrl }] : [])
];
const activeBreadcrumbs = breadcrumbs.length > 0 ? breadcrumbs : defaultBreadcrumbs;

const structuredData = serializeJsonLd(buildPageSchema({
  title: pageName,
  description,
  canonicalUrl,
  imageUrl: ogImageUrl,
  breadcrumbs: activeBreadcrumbs,
  article,
  faq,
  codeSnippet,
  isPart,
  chapterNum
}));
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={article ? "article" : "website"} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/site.webmanifest" />

    <!-- CodeMirror Assets via CDN -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.16/codemirror.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.16/theme/dracula.min.css" />
    <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.16/codemirror.min.js"></script>
    <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.16/mode/clike/clike.min.js"></script>
    <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.16/mode/javascript/javascript.min.js"></script>
    <script is:inline src="/highlight.js"></script>
    <script is:inline>
      (function() {
        function initZigMode() {
          if (typeof CodeMirror === 'undefined') return;
          function words(str) {
            var obj = {}, w = str.split(' ');
            for (var i = 0; i < w.length; ++i) obj[w[i]] = true;
            return obj;
          }

          var zigKeywords = "const var fn pub comptime defer errdefer return if else switch try catch orelse while for break continue test unreachable usingnamespace struct enum union error inline noinline resume suspend nosuspend async await threadlocal export extern align and or anytype";
          var zigTypes = "i8 u8 i16 u16 i32 u32 i64 u64 i128 u128 isize usize f16 f32 f64 f128 c_char c_short c_ushort c_int c_uint c_long c_ulong c_longlong c_ulonglong c_longdouble bool void anyopaque type anyerror noreturn";
          var zigBuiltins = words("@import @as @intCast @floatCast @ptrCast @truncate @typeInfo @TypeOf @alignOf @sizeOf @embedFile @compileError @panic @hasDecl @field @memcpy @memset @tagName @atomicLoad @atomicStore @bitCast @floatFromInt @intFromFloat @intFromPtr @ptrFromInt @setEvalBranchQuota @This @typeName");

          var zigConfig = {
            name: "clike",
            keywords: words(zigKeywords),
            types: words(zigTypes),
            builtin: zigBuiltins,
            atoms: words("true false null undefined"),
            hooks: {
              "@": function(stream) {
                stream.eatWhile(/[\w]/);
                return "builtin";
              }
            }
          };

          CodeMirror.defineMIME("text/x-csrc", zigConfig);
          CodeMirror.defineMIME("text/x-zig", zigConfig);
        }

        initZigMode();
        if (typeof window !== 'undefined') {
          window.addEventListener('DOMContentLoaded', initZigMode);
        }
      })();
    </script>

    <!-- Schema.org Structured Data -->
    <script type="application/ld+json" set:html={structuredData} />
  </head>
  <body>
  <a href="#main-content" class="skip-to-content">Skip to main content</a>
    <slot />
  </body>
</html>
