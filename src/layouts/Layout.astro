---
interface Props {
  title?: string;
  description?: string;
  canonicalPath?: string;
  breadcrumbs?: { name: string; item: string }[];
}

const {
  title = "Zig for Node.js Devs | Interactive GitBook & Live Compiler",
  description = "Learn Zig with live in-browser Zig Compiler Explorer & Playground, progressive lessons, side-by-side Node.js/TypeScript comparisons, and production systems architecture guides.",
  canonicalPath = Astro.url.pathname,
  breadcrumbs = []
} = Astro.props;

import '../styles/global.css';

const siteOrigin = "https://zig-for-node-devs.vercel.app";
const cleanPath = canonicalPath.replace(/\/+$/, '') || '';
const canonicalUrl = `${siteOrigin}${cleanPath}`;
const ogImageUrl = `${siteOrigin}/og-image.png`;

const defaultBreadcrumbs = [
  { name: "Home", item: siteOrigin },
  ...(cleanPath ? [{ name: title.split('|')[0].trim(), item: canonicalUrl }] : [])
];
const activeBreadcrumbs = breadcrumbs.length > 0 ? breadcrumbs : defaultBreadcrumbs;

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": `${siteOrigin}/#website`,
      "url": siteOrigin,
      "name": "Zig for Node.js Developers Masterclass Studio",
      "description": "Interactive Zig systems learning platform and Rosetta Stone for Node.js and TypeScript developers.",
      "inLanguage": "en-US",
      "publisher": {
        "@type": "Person",
        "name": "Nadim Tuhin",
        "url": "https://github.com/nadimtuhin"
      }
    },
    {
      "@type": "Course",
      "@id": `${siteOrigin}/#course`,
      "name": "Zig for Node.js & TypeScript Developers",
      "description": "Comprehensive transition guide from single-threaded V8 JavaScript to explicit memory management, comptime metaprogramming, and bare-metal systems programming in Zig.",
      "provider": {
        "@type": "Person",
        "name": "Nadim Tuhin",
        "sameAs": "https://github.com/nadimtuhin"
      }
    },
    {
      "@type": "BreadcrumbList",
      "@id": `${canonicalUrl}/#breadcrumbs`,
      "itemListElement": activeBreadcrumbs.map((bc, idx) => ({
        "@type": "ListItem",
        "position": idx + 1,
        "name": bc.name,
        "item": bc.item
      }))
    }
  ]
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/site.webmanifest" />

    <!-- CodeMirror Assets via CDN -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.16/codemirror.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.16/theme/dracula.min.css" />
    <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.16/codemirror.min.js"></script>
    <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.16/mode/clike/clike.min.js"></script>
    <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.16/mode/javascript/javascript.min.js"></script>
    <script is:inline src="/highlight.js"></script>
    <script is:inline>
      (function() {
        function initZigMode() {
          if (typeof CodeMirror === 'undefined') return;
          function words(str) {
            var obj = {}, w = str.split(' ');
            for (var i = 0; i < w.length; ++i) obj[w[i]] = true;
            return obj;
          }

          var zigKeywords = "const var fn pub comptime defer errdefer return if else switch try catch orelse while for break continue test unreachable usingnamespace struct enum union error inline noinline resume suspend nosuspend async await threadlocal export extern align and or anytype";
          var zigTypes = "i8 u8 i16 u16 i32 u32 i64 u64 i128 u128 isize usize f16 f32 f64 f128 c_char c_short c_ushort c_int c_uint c_long c_ulong c_longlong c_ulonglong c_longdouble bool void anyopaque type anyerror noreturn";
          var zigBuiltins = words("@import @as @intCast @floatCast @ptrCast @truncate @typeInfo @TypeOf @alignOf @sizeOf @embedFile @compileError @panic @hasDecl @field @memcpy @memset @tagName @atomicLoad @atomicStore @bitCast @floatFromInt @intFromFloat @intFromPtr @ptrFromInt @setEvalBranchQuota @This @typeName");

          var zigConfig = {
            name: "clike",
            keywords: words(zigKeywords),
            types: words(zigTypes),
            builtin: zigBuiltins,
            atoms: words("true false null undefined"),
            hooks: {
              "@": function(stream) {
                stream.eatWhile(/[\w]/);
                return "builtin";
              }
            }
          };

          CodeMirror.defineMIME("text/x-csrc", zigConfig);
          CodeMirror.defineMIME("text/x-zig", zigConfig);
        }

        initZigMode();
        if (typeof window !== 'undefined') {
          window.addEventListener('DOMContentLoaded', initZigMode);
        }
      })();
    </script>

    <!-- Schema.org Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </head>
  <body>
  <a href="#main-content" class="skip-to-content">Skip to main content</a>
    <slot />
  </body>
</html>
