---
import Layout from '../layouts/Layout.astro';
import { guideSchemas } from '../data/guideSchemas';
import Footer from '../components/Footer.astro';
import GuideFaq from '../components/GuideFaq.astro';
import ViewComponent from '../components/views/TroubleshootingView.astro';
---

<Layout title="Diagnostics & Debugging Playbook | Zig for Node Devs" {...guideSchemas.troubleshooting}>
  <main id="main-content" role="main" style="min-height: 100vh; overflow-y: auto;">
    <ViewComponent />
    <GuideFaq faq={guideSchemas.troubleshooting.faq} />
    <Footer />
  </main>
</Layout>
