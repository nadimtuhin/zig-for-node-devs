---
import Layout from '../layouts/Layout.astro';
import { guideSchemas } from '../data/guideSchemas';
import Footer from '../components/Footer.astro';
import GuideFaq from '../components/GuideFaq.astro';
import ViewComponent from '../components/views/PitfallsView.astro';
---

<Layout title="Top 8 Zig Pitfalls & Footguns | Zig for Node Devs" {...guideSchemas.pitfalls}>
  <main id="main-content" role="main" style="min-height: 100vh; overflow-y: auto;">
    <ViewComponent />
    <GuideFaq faq={guideSchemas.pitfalls.faq} />
    <Footer />
  </main>
</Layout>
