---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ViewComponent from '../components/views/PitfallsView.astro';
---

<Layout title="Top 8 Zig Pitfalls & Footguns | Zig for Node Devs" description="The 8 common traps where JavaScript intuition leads to bugs: dangling slice pointers, uninitialized memory traps, and allocator lifecycles.">
  <Header />
  <main id="main-content" role="main" style="min-height: calc(100vh - 54px); overflow-y: auto;">
    <ViewComponent />
    <Footer />
  </main>
</Layout>
