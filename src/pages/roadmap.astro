---
import Layout from '../layouts/Layout.astro';
import { guideSchemas } from '../data/guideSchemas';
import Footer from '../components/Footer.astro';
import GuideFaq from '../components/GuideFaq.astro';
import RelatedLinks from '../components/RelatedLinks.astro';
import { guideRelatedLinks } from '../data/topicClusters';
import RoadmapView from '../components/views/RoadmapView.astro';
---

<Layout 
  title="Zig Developer Roadmap 2026 (roadmap.sh style) | Zig for Node Devs" 
  {...guideSchemas.roadmap}
  canonicalPath="/roadmap"
>
  <main id="main-content" role="main" style="min-height: 100vh; overflow-y: auto;">
    <RoadmapView />
    <div style="max-width: 960px; margin: 0 auto; padding: 0 1.5rem 2rem;">
      <RelatedLinks id="guideRelatedLinks" heading="Related Lessons & Architecture Guides" links={guideRelatedLinks('roadmap')} />
    </div>
    <GuideFaq faq={guideSchemas.roadmap.faq} />
    <Footer />
  </main>
</Layout>
