---
import Layout from '../layouts/Layout.astro';
import Footer from '../components/Footer.astro';
import RoadmapView from '../components/views/RoadmapView.astro';
---

<Layout 
  title="Zig Developer Roadmap 2026 (roadmap.sh style) | Zig for Node Devs" 
  description="Step-by-step visual learning roadmap for JavaScript, TypeScript, and Node.js developers learning Zig. Core milestones, memory models, comptime, and production systems."
  canonicalPath="/roadmap"
>
  <main id="main-content" role="main" style="min-height: 100vh; overflow-y: auto;">
    <RoadmapView />
    <Footer />
  </main>
</Layout>
