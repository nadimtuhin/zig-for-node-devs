---
import Layout from '../layouts/Layout.astro';
import { guideSchemas } from '../data/guideSchemas';
import Footer from '../components/Footer.astro';
import GuideFaq from '../components/GuideFaq.astro';
import ViewComponent from '../components/views/BuildSystemView.astro';
---

<Layout title="build.zig vs npm & Package Management | Zig for Node Devs" {...guideSchemas.buildSystem}>
  <main id="main-content" role="main" style="min-height: 100vh; overflow-y: auto;">
    <ViewComponent />
    <GuideFaq faq={guideSchemas.buildSystem.faq} />
    <Footer />
  </main>
</Layout>
