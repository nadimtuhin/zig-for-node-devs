---
import Layout from '../layouts/Layout.astro';
import { guideSchemas } from '../data/guideSchemas';
import Footer from '../components/Footer.astro';
import GuideFaq from '../components/GuideFaq.astro';
import ViewComponent from '../components/views/DockerView.astro';
---

<Layout title="Production Docker Recipes (< 5MB Scratch) | Zig for Node Devs" {...guideSchemas.docker}>
  <main id="main-content" role="main" style="min-height: 100vh; overflow-y: auto;">
    <ViewComponent />
    <GuideFaq faq={guideSchemas.docker.faq} />
    <Footer />
  </main>
</Layout>
