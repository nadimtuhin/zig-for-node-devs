---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ViewComponent from '../components/views/DockerView.astro';
---

<Layout title="Production Docker Recipes (< 5MB Scratch) | Zig for Node Devs" description="Zero-vulnerability scratch Docker recipes, multi-stage builds, and deployment strategies for Zig binaries.">
  <Header />
  <main id="main-content" role="main" style="min-height: calc(100vh - 54px); overflow-y: auto;">
    <ViewComponent />
    <Footer />
  </main>
</Layout>
