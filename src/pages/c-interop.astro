---
import Layout from '../layouts/Layout.astro';
import { guideSchemas } from '../data/guideSchemas';
import Footer from '../components/Footer.astro';
import GuideFaq from '../components/GuideFaq.astro';
import ViewComponent from '../components/views/CInteropView.astro';
---

<Layout title="C Interoperability & Node-API Addons | Zig for Node Devs" {...guideSchemas.cInterop}>
  <main id="main-content" role="main" style="min-height: 100vh; overflow-y: auto;">
    <ViewComponent />
    <GuideFaq faq={guideSchemas.cInterop.faq} />
    <Footer />
  </main>
</Layout>
