---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ViewComponent from '../components/views/CInteropView.astro';
---

<Layout title="C Interoperability & Node-API Addons | Zig for Node Devs" description="How to use Zig as a C compiler, import C headers via @cImport, and build lightning-fast native Node.js addons without node-gyp.">
  <Header />
  <main id="main-content" role="main" style="min-height: calc(100vh - 54px); overflow-y: auto;">
    <ViewComponent />
    <Footer />
  </main>
</Layout>
