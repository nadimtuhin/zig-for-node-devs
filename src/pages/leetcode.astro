---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ViewComponent from '../components/views/LeetcodeView.astro';
---

<Layout title="LeetCode Easy & Classic Algorithms in Zig | Zig for Node Devs" description="Two Sum, Valid Parentheses, Reverse Linked List, Binary Search, and Kadane's algorithm solved with zero-allocation Zig patterns.">
  <Header />
  <main id="main-content" role="main" style="min-height: calc(100vh - 54px); overflow-y: auto;">
    <ViewComponent />
    <Footer />
  </main>
</Layout>
