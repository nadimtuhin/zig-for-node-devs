---
import Layout from '../layouts/Layout.astro';
import { guideSchemas } from '../data/guideSchemas';
import Footer from '../components/Footer.astro';
import GuideFaq from '../components/GuideFaq.astro';
import ViewComponent from '../components/views/InterviewsView.astro';
---

<Layout title="Senior Systems Interview Q&A | Zig for Node Devs" {...guideSchemas.interviews}>
  <main id="main-content" role="main" style="min-height: 100vh; overflow-y: auto;">
    <ViewComponent />
    <GuideFaq faq={guideSchemas.interviews.faq} />
    <Footer />
  </main>
</Layout>
